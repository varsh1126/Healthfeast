# ==============================================================================
# HealthFeast Environment Configuration
# ==============================================================================

# Local dev override for the backend. Keep this on 8001 because 8000 is commonly
# already occupied on Windows and other local workstations.
PORT=8001

# Django Core
DJANGO_SECRET_KEY=your-production-django-secret-key-change-this-in-prod-xyz123
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL in production, SQLite fallback in local dev)
# If DATABASE_URL is set, it overrides the individual POSTGRES_* settings.
DATABASE_URL=postgresql://healthfeast_user:healthfeast_pass@localhost:5432/healthfeast_db
# POSTGRES_DB=healthfeast_db
# POSTGRES_USER=healthfeast_user
# POSTGRES_PASSWORD=healthfeast_pass
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Google Gemini AI API Configuration
# Optional: If not provided or quota exceeded, HealthFeast automatically operates in
# full offline/demo fallback mode with deterministic AI rules, knowledge base citations,
# and intelligent visual food heuristics.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
DEMO_MODE=True

# Frontend API Configuration (for Vite production builds / Vercel)
VITE_API_URL=http://localhost:8001/api
