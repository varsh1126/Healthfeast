{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HealthFeast: Start Backend (Django)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe manage.py runserver 127.0.0.1:8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Watching for file changes",
          "endsPattern": "Starting development server at"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers",
        "clear": false
      }
    },
    {
      "label": "HealthFeast: Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers",
        "clear": false
      }
    },
    {
      "label": "HealthFeast: Start Full Stack (Backend + Frontend)",
      "dependsOn": [
        "HealthFeast: Start Backend (Django)",
        "HealthFeast: Start Frontend (Vite)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "HealthFeast: Run Tests",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe manage.py test",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "HealthFeast: Seed Database",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe manage.py seed_data",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
